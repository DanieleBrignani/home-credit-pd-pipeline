FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl libpcre2-8-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY infra/requirements-serving.txt /tmp/req.txt
RUN pip install -r /tmp/req.txt
COPY pyproject.toml /app/
COPY src /app/src
RUN pip install --no-deps .
# The runtime image needs no package installer; pip bundles its own copies of urllib3/msgpack that scanners flag.
RUN pip uninstall -y pip setuptools wheel
RUN useradd -r -u 10001 app && chown -R app /app
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD curl -fs http://localhost:8000/health || exit 1
CMD ["uvicorn", "creditrisk.api:app_factory", "--factory", "--host", "0.0.0.0", "--port", "8000"]
