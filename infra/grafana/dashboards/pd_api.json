{
 "title": "PD scoring API",
 "uid": "pd-api",
 "schemaVersion": 39,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests / s by status",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(pd_api_requests_total[1m])) by (status)",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latency p50 / p95 (s)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(pd_api_request_seconds_bucket[5m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(pd_api_request_seconds_bucket[5m])) by (le))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Predicted PD distribution (cumulative buckets rate)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(pd_prediction_probability_bucket[10m])) by (le)",
     "legendFormat": "le={{le}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Mean predicted PD (10m)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(pd_prediction_probability_sum[10m])) / clamp_min(sum(rate(pd_prediction_probability_count[10m])),1e-9)",
     "legendFormat": "mean PD"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Feature missingness share (15m)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(pd_feature_missing_total[15m])) by (feature) / sum(rate(pd_feature_observed_total[15m])) by (feature)",
     "legendFormat": "{{feature}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Errors by type",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(pd_api_errors_total[5m])) by (type)",
     "legendFormat": "{{type}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Active model version",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "pd_model_info",
     "legendFormat": "v{{version}} {{family}} {{feature_schema}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "History-lookup misses / s",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "rate(pd_history_lookup_miss_total[5m])",
     "legendFormat": "misses"
    }
   ]
  }
 ]
}